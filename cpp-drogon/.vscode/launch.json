{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "server (gdb)",
      "type": "cppdbg",
      "request": "launch",
      "program": "${workspaceFolder}/build/server",
      "cwd": "${workspaceFolder}",
      "environment": [{ "name": "PORT", "value": "8002" }],
      "MIMode": "gdb",
      "miDebuggerPath": "gdb",
      "setupCommands": [{ "text": "-enable-pretty-printing", "ignoreFailures": true }],
      "preLaunchTask": "build"
    },
    {
      "name": "client (gdb)",
      "type": "cppdbg",
      "request": "launch",
      "program": "${workspaceFolder}/build/client",
      "cwd": "${workspaceFolder}",
      "environment": [{ "name": "API_URL", "value": "http://127.0.0.1:8002" }],
      "MIMode": "gdb",
      "miDebuggerPath": "gdb",
      "setupCommands": [{ "text": "-enable-pretty-printing", "ignoreFailures": true }],
      "preLaunchTask": "build"
    }
  ]
}
