{
  // clangd / clang-format / clang-tidy / cmake / gdb は nix devShell のものを使う（mkhl.direnv が .envrc を読み込む）
  // clangd は build/compile_commands.json（CMAKE_EXPORT_COMPILE_COMMANDS）を読み、.clang-tidy のチェックも表示する
  "clangd.path": "clangd",
  "clangd.checkUpdates": false,
  "clangd.arguments": ["--clang-tidy", "--header-insertion=never"],
  // 補完・診断・フォーマットは clangd に任せ、cpptools はデバッガ (gdb) としてだけ使う
  "C_Cpp.intelliSenseEngine": "disabled",
  "C_Cpp.formatting": "disabled",
  // CMake Tools は CMakePresets.json の dev プリセット（Ninja / Debug → build/）で構成・ビルドする
  "cmake.useCMakePresets": "always",
  "cmake.configureOnOpen": true,
  "[cpp]": {
    "editor.defaultFormatter": "llvm-vs-code-extensions.vscode-clangd",
    "editor.formatOnSave": true
  }
}
