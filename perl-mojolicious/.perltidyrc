# perltidy の設定（Mojolicious 本体の .perltidyrc と同じスタイル）
-pbp     # Perl Best Practices をベースに
-w       # 警告をすべて表示
-iob     # 元の改行位置を無視
-l=120   # 1 行 120 文字
-mbl=2   # 空行は最大 2 行
-i=2     # インデント 2
-ci=2    # 継続行のインデント 2
-vt=0    # 縦方向の詰めを弱く
-pt=2    # ( ) の内側に空白を入れない
-bt=2    # { } の内側に空白を入れない
-sbt=2   # [ ] の内側に空白を入れない
-wn      # ネストした括弧をくっつける
-isbc    # 先頭に空白のないコメントはインデントしない
-nst     # 標準出力ではなくファイルに書く
