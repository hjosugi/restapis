;; Clojure CLI の依存定義。Maven のバージョンを固定しているので、これがロックファイル代わり
{:paths ["src"]
 :deps {org.clojure/clojure {:mvn/version "1.12.7"}
        ;; サーバー: reitit (ルーティング) + Ring の Jetty アダプタ
        metosin/reitit-ring {:mvn/version "0.11.0"}
        metosin/reitit-middleware {:mvn/version "0.11.0"} ; 例外処理 / クエリパラメータ / muuntaja 連携
        metosin/reitit-malli {:mvn/version "0.11.0"} ; malli スキーマで入力チェック (coercion)
        metosin/malli {:mvn/version "0.20.3"}
        metosin/muuntaja {:mvn/version "0.6.12"} ; JSON のエンコード / デコード
        ring/ring-jetty-adapter {:mvn/version "1.15.6"}
        org.slf4j/slf4j-simple {:mvn/version "2.0.20"} ; Jetty のログを標準エラーに出す
        ;; クライアント: babashka/http-client (JDK の java.net.http ベース) + jsonista (JSON)
        org.babashka/http-client {:mvn/version "0.4.26"}
        metosin/jsonista {:mvn/version "1.0.2"}}
 :aliases {;; clojure -M:server / clojure -M:client
           :server {:main-opts ["-m" "users.server"]}
           :client {:main-opts ["-m" "users.client"]}}}
