%% elvis（Erlang のスタイルチェッカー）の設定。既定のルールセット erl_files を使う
[
    {config, [
        #{
            files => ["src/*.erl"],
            ruleset => erl_files,
            rules => [
                %% クライアントは結果を表示するのが仕事なので io:format を許可する
                {elvis_style, no_debug_call, #{ignore => [users_client]}}
            ]
        },
        #{files => ["rebar.config"], ruleset => rebar_config}
    ]}
].
